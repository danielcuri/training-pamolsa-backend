# MySQL (local: docker compose up -d mysql)
DATABASE_URL="mysql://nestuser:nestpassword@127.0.0.1:3308/db_training"

JWT_SECRET="change_me"
JWT_EXPIRES_IN="7d"

# Swagger UI: en producción (NODE_ENV=production) debe ser exactamente "true" para ver /docs
ENABLE_SWAGGER="true"

# Bootstrap POST /api/configuration/seed-admin (sin relación con Swagger)
ALLOW_CONFIGURATION="false"
